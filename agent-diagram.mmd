flowchart TD
    U["User query\n(natural language text)"]

    U --> HQ

    subgraph APP["app.py — handle_query()"]
        HQ{"Empty\nquery?"}
        HQ -->|yes| APPERR["Return error string\nto Gradio UI"]
        HQ -->|no| WARDOBE["Select wardrobe\n(example or empty)"]
    end

    WARDOBE --> AGENT

    subgraph AGENT["agent.py — run_agent()"]
        PARSE["_parse_query()\nRegex → description · size · max_price"]

        T1["search_listings()\ndescription, size, max_price → ranked listings"]
        T2["suggest_outfit()\nselected_item, wardrobe → outfit string"]
        T3["create_fit_card()\noutfit_suggestion, selected_item → OOTD caption"]

        STATE[("Session state\n────────────\nquery\nparsed\nsearch_results\nselected_item\nwardrobe\noutfit_suggestion\nfit_card\nerror")]

        PARSE --> T1
        T1 -->|"store search_results\nselect top item"| T2
        T2 -->|"store outfit_suggestion"| T3
        T3 -->|"store fit_card"| DONE["Session complete"]

        T1 -.->|write| STATE
        T2 -.->|write| STATE
        T3 -.->|write| STATE

        T1 -->|no results| ERR1["session[error] set\n→ return early"]
        T2 -->|empty wardrobe| WARN2["General styling advice\n(no exception raised)"]
        WARN2 --> T3
        T3 -->|"exception on LLM call\n(retry up to 20×)"| RETRY{"Retries\nexhausted?"}
        RETRY -->|no| T3
        RETRY -->|yes| ERR3["session[error] set\n→ return early"]
    end

    DONE --> OUT["Output to Gradio UI\nlisting · outfit suggestion · fit card"]

    style STATE    fill:#EEEDFE,stroke:#534AB7,color:#3C3489
    style ERR1     fill:#FCEBEB,stroke:#A32D2D,color:#791F1F
    style ERR3     fill:#FCEBEB,stroke:#A32D2D,color:#791F1F
    style APPERR   fill:#FCEBEB,stroke:#A32D2D,color:#791F1F
    style WARN2    fill:#FAEEDA,stroke:#854F0B,color:#633806
    style T1       fill:#E1F5EE,stroke:#0F6E56,color:#085041
    style T2       fill:#E1F5EE,stroke:#0F6E56,color:#085041
    style T3       fill:#E1F5EE,stroke:#0F6E56,color:#085041
    style OUT      fill:#EEEDFE,stroke:#534AB7,color:#3C3489
    style DONE     fill:#F1EFE8,stroke:#5F5E5A,color:#444441
    style PARSE    fill:#E1F5EE,stroke:#0F6E56,color:#085041
    style HQ       fill:#F1EFE8,stroke:#5F5E5A,color:#444441
    style RETRY    fill:#F1EFE8,stroke:#5F5E5A,color:#444441
    style U        fill:#F1EFE8,stroke:#5F5E5A,color:#444441
    style WARDOBE  fill:#F1EFE8,stroke:#5F5E5A,color:#444441
